# CineVault Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon / Supabase / Local PostgreSQL)
# Example for PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/cinevault?sslmode=require"
# For zero-config local testing, SQLite dev.db is supported:
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="cinevault_super_secure_jwt_secret_key_2026_production_change_in_prod"
JWT_EXPIRES_IN="7d"

# Client CORS Origin
FRONTEND_URL="http://localhost:5173"

# Legal Media Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
