datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  name            String
  role            String           @default("USER") // "USER" | "ADMIN"
  avatarUrl       String?
  bio             String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reviews         Review[]
  watchlist       Watchlist[]
  watchHistory    WatchHistory[]
  ratings         Rating[]
  adminActions    AdminAction[]
  rightsAuditLogs RightsAuditLog[]
}

model Movie {
  id                  String           @id @default(uuid())
  title               String
  slug                String           @unique
  originalTitle       String?
  description         String
  releaseYear         Int
  releaseDate         DateTime?
  durationMinutes     Int
  director            String?
  rating              Float            @default(0.0)
  ratingsCount        Int              @default(0)
  posterUrl           String
  backdropUrl         String?
  trailerUrl          String
  videoSourceUrl      String?
  externalStreamUrl   String?
  sourceProvider      String?
  contentRightsStatus String           @default("UNVERIFIED") // "PUBLIC_DOMAIN" | "OWNED_CONTENT" | "LICENSED" | "AUTHORIZED_PROVIDER" | "TRAILER_ONLY" | "UNVERIFIED"
  publicationStatus   String           @default("DRAFT") // "DRAFT" | "RIGHTS_REVIEW" | "APPROVED" | "PUBLISHED" | "UNPUBLISHED"
  rightsHolder        String?
  licenseDocument     String?
  licenseStartDate    DateTime?
  licenseEndDate      DateTime?
  ownershipConfirmed  Boolean          @default(false)
  licenseNotes        String
  language            String           @default("English")
  country             String           @default("United States")
  isFeatured          Boolean          @default(false)
  isTrending          Boolean          @default(false)
  viewCount           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  genres              MovieGenre[]
  castMembers         MovieCast[]
  reviews             Review[]
  watchlists          Watchlist[]
  watchHistories      WatchHistory[]
  ratings             Rating[]
  rightsAuditLogs     RightsAuditLog[]
}

model Genre {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  description String?
  icon        String?
  movies      MovieGenre[]
}

model MovieGenre {
  id        String   @id @default(uuid())
  movieId   String
  genreId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre     Genre    @relation(fields: [genreId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([movieId, genreId])
}

model Cast {
  id         String      @id @default(uuid())
  name       String
  roleType   String      @default("ACTOR")
  profileUrl String?
  bio        String?
  movies     MovieCast[]
}

model MovieCast {
  id            String   @id @default(uuid())
  movieId       String
  castId        String
  characterName String?
  role          String   @default("ACTOR")
  order         Int      @default(0)
  movie         Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  cast          Cast     @relation(fields: [castId], references: [id], onDelete: Cascade)

  @@unique([movieId, castId, role])
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  movieId    String
  rating     Int
  content    String
  isApproved Boolean  @default(true)
  isFlagged  Boolean  @default(false)
  flagReason String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model WatchHistory {
  id                   String   @id @default(uuid())
  userId               String
  movieId              String
  progressSeconds      Int      @default(0)
  durationSeconds      Int      @default(0)
  completionPercentage Float    @default(0.0)
  lastWatchedAt        DateTime @default(now())

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie                Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model RightsAuditLog {
  id                String   @id @default(uuid())
  adminId           String
  movieId           String
  action            String
  rightsStatus      String
  publicationStatus String
  reason            String
  createdAt         DateTime @default(now())

  admin             User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  movie             Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  actionType String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}
