# CineVault Environment Variables Reference

# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ==============================================================================
PORT=5000
NODE_ENV=development

# Database Connection
# For production PostgreSQL (Neon, Supabase, Render, Railway):
DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/cinevault?sslmode=require"

# For zero-config local development, SQLite is supported out of the box:
# DATABASE_URL="file:./dev.db"

# JWT Authentication Secret & Expiration
JWT_SECRET="cinevault_super_secure_jwt_secret_key_2026_production_change_in_prod"
JWT_EXPIRES_IN="7d"

# Client CORS Origin
FRONTEND_URL="http://localhost:5173"

# Legal Media Cloud Storage (Cloudinary - for authorized posters & backdrops)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional External Metadata API (TMDB for legal trailers & cast metadata)
TMDB_API_KEY=""

# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ==============================================================================
VITE_API_URL="http://localhost:5000/api"
